BT /F3 8.2 Tf 1 0 0 1 62 488.4 Tm (// ---------- verify middleware ----------) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 478.4 Tm (export function authenticate\(req, res, next\) {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 468.4 Tm (  const token = req.get\("authorization"\)?.replace\(/^Bearer /, ""\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 458.4 Tm (  if \(!token\) return res.status\(401\).json\({ error: "Missing token" }\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 448.4 Tm (  try {) Tj ET
