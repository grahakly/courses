BT /F3 8.2 Tf 1 0 0 1 62 728.0 Tm (// 1. correlation id - first, so everything downstream can log it) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 718.0 Tm (app.use\(\(req, res, next\) => {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 708.0 Tm (  req.id = req.get\("x-request-id"\) ?? randomUUID\(\);) Tj ET
