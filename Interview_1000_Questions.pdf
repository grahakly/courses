BT /F2 12 Tf 1 0 0 1 54 372.7 Tm (Code Example) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 342.5 Tm (WITH monthly AS \() Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 332.5 Tm (    SELECT DATE_TRUNC\('month', o.order_date\)::date        AS month,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 322.5 Tm (           SUM\(oi.quantity * oi.unit_price\)               AS revenue) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 312.5 Tm (    FROM   orders o) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 302.5 Tm (    JOIN   order_items oi ON oi.order_id = o.order_id) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 292.5 Tm (    WHERE  o.status <> 'CANCELLED') Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 282.5 Tm (    GROUP  BY DATE_TRUNC\('month', o.order_date\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 272.5 Tm (\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 262.5 Tm (SELECT month,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 252.5 Tm (       revenue,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 242.5 Tm (       LAG\(revenue\)  OVER \(ORDER BY month\)               AS prev_month,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 232.5 Tm (       LEAD\(revenue\) OVER \(ORDER BY month\)               AS next_month,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 222.5 Tm (       revenue - LAG\(revenue\) OVER \(ORDER BY month\)      AS delta,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 212.5 Tm (       ROUND\(100.0 * \(revenue - LAG\(revenue\) OVER \(ORDER BY month\)\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 202.4 Tm (             / NULLIF\(LAG\(revenue\) OVER \(ORDER BY month\), 0\), 1\) AS growth_pct,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 192.4 Tm (       -- default argument: report the first month's delta against 0 instead of NULL) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 182.4 Tm (       revenue - LAG\(revenue, 1, 0::numeric\) OVER \(ORDER BY month\) AS delta_no_null) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 172.4 Tm (FROM   monthly) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 162.4 Tm (ORDER  BY month;) Tj ET
BT /F2 12 Tf 1 0 0 1 54 130.4 Tm (Output) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 100.2 Tm (   month    |  revenue  | prev_month | next_month |   delta   | growth_pct | delta_no_null) Tj ET
