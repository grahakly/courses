BT /F3 8.2 Tf 1 0 0 1 62 372.4 Tm (       COUNT\(DISTINCT country\)     AS distinct_countries,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 362.4 Tm (       COUNT\(last_support_contact\) AS ever_contacted_support) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 352.4 Tm (FROM   customers;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 335.0 Tm (-- The AVG trap, side by side) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 325.0 Tm (SELECT COUNT\(*\)                          AS orders_total,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 315.0 Tm (       COUNT\(discount_pct\)               AS orders_with_discount,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 305.0 Tm (       SUM\(discount_pct\)                 AS discount_sum,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 295.0 Tm (       ROUND\(AVG\(discount_pct\), 2\)       AS avg_ignoring_nulls,      -- /3) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 285.0 Tm (       ROUND\(AVG\(COALESCE\(discount_pct,0\)\), 2\) AS avg_treating_null_as_zero -- /8) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 275.0 Tm (FROM   orders;) Tj ET
BT /F2 12 Tf 1 0 0 1 54 243.0 Tm (Output) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 212.8 Tm ( all_rows | with_city | distinct_countries | ever_contacted_support) Tj ET
