BT /F3 8.2 Tf 1 0 0 1 62 544.6 Tm (const client = new MongoClient\(uri, {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 534.6 Tm (  writeConcern: { w: "majority", j: true, wtimeoutMS: 5000 },) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 524.6 Tm (  readPreference: "primaryPreferred",) Tj ET
