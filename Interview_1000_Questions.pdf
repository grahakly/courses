BT /F3 8.2 Tf 1 0 0 1 62 686.8 Tm (-- Declarative range partitioning \(Postgres 12+\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 676.8 Tm (CREATE TABLE orders_p \() Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 666.8 Tm (    order_id    BIGSERIAL,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 656.8 Tm (    customer_id INT  NOT NULL,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 646.8 Tm (    order_date  DATE NOT NULL,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 636.8 Tm (    status      VARCHAR\(20\) NOT NULL,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 626.8 Tm (    PRIMARY KEY \(order_id, order_date\)          -- key must include the partition column) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 616.8 Tm (\) PARTITION BY RANGE \(order_date\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 599.4 Tm (CREATE TABLE orders_2025_01 PARTITION OF orders_p) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 589.4 Tm (    FOR VALUES FROM \('2025-01-01'\) TO \('2025-02-01'\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 579.4 Tm (CREATE TABLE orders_2025_02 PARTITION OF orders_p) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 569.4 Tm (    FOR VALUES FROM \('2025-02-01'\) TO \('2025-03-01'\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 559.4 Tm (CREATE TABLE orders_2025_03 PARTITION OF orders_p) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 549.4 Tm (    FOR VALUES FROM \('2025-03-01'\) TO \('2025-04-01'\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 539.4 Tm (CREATE TABLE orders_default PARTITION OF orders_p DEFAULT;   -- catch-all) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 522.0 Tm (-- Indexes defined on the parent propagate to every partition) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 512.0 Tm (CREATE INDEX ON orders_p \(customer_id\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 494.6 Tm (INSERT INTO orders_p \(customer_id, order_date, status\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 484.6 Tm (SELECT customer_id, order_date, status FROM orders;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 467.2 Tm (-- PRUNING: only the February child is scanned) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 457.2 Tm (EXPLAIN \(ANALYZE\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 447.2 Tm (SELECT COUNT\(*\) FROM orders_p) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 437.2 Tm (WHERE order_date >= '2025-02-01' AND order_date < '2025-03-01';) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 419.8 Tm (-- NO PRUNING: partition key absent, every partition is scanned) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 409.8 Tm (EXPLAIN SELECT COUNT\(*\) FROM orders_p WHERE customer_id = 1;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 392.4 Tm (-- Retention: instant, no bloat, versus a multi-hour DELETE) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 382.4 Tm (DROP TABLE orders_2025_01;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 372.4 Tm (-- or keep the data but detach it from the live table) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 362.4 Tm (-- ALTER TABLE orders_p DETACH PARTITION orders_2025_01 CONCURRENTLY;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 345.0 Tm (-- Hash partitioning when there is no natural range) Tj ET
