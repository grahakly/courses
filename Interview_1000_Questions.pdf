BT /F2 12 Tf 1 0 0 1 54 717.0 Tm (Code Example) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 686.8 Tm (-- One level of hierarchy. LEFT JOIN so the CTO is not lost.) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 676.8 Tm (SELECT e.employee_id,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 666.8 Tm (       e.full_name                        AS employee,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 656.8 Tm (       e.department,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 646.8 Tm (       COALESCE\(m.full_name, '\(none\)'\)    AS manager,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 636.8 Tm (       -- flag employees paid more than their manager) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 626.8 Tm (       CASE WHEN e.salary > m.salary THEN 'YES' ELSE 'no' END AS out_earns_manager) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 616.8 Tm (FROM   employees e) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 606.8 Tm (LEFT   JOIN employees m ON m.employee_id = e.manager_id) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 596.8 Tm (ORDER  BY e.employee_id;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 579.4 Tm (-- Self join to find pairs of colleagues in the same department on equal salary.) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 569.4 Tm (-- e1.employee_id < e2.employee_id avoids self-pairs and mirrored duplicates.) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 559.4 Tm (SELECT e1.full_name AS employee_a,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 549.4 Tm (       e2.full_name AS employee_b,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 539.4 Tm (       e1.department,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 529.4 Tm (       e1.salary) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 519.4 Tm (FROM   employees e1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 509.4 Tm (JOIN   employees e2) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 499.3 Tm (       ON  e1.department = e2.department) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 489.3 Tm (       AND e1.salary     = e2.salary) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 479.3 Tm (       AND e1.employee_id < e2.employee_id;) Tj ET
BT /F2 12 Tf 1 0 0 1 54 447.3 Tm (Output) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 417.1 Tm ( employee_id |   employee   | department  |   manager   | out_earns_manager) Tj ET
