BT /F3 8.2 Tf 1 0 0 1 62 686.8 Tm (# --- brute force: O\(n^2\) time, O\(1\) space ---) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 676.8 Tm (def two_sum_brute\(nums, target\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 666.8 Tm (    for i in range\(len\(nums\)\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 656.8 Tm (        for j in range\(i + 1, len\(nums\)\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 646.8 Tm (            if nums[i] + nums[j] == target:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 636.8 Tm (                return [i, j]) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 626.8 Tm (    return []) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 609.4 Tm (# --- sorted input: two pointers, O\(n\) time, O\(1\) space ---) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 599.4 Tm (def two_sum_sorted\(nums, target\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 589.4 Tm (    left, right = 0, len\(nums\) - 1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 579.4 Tm (    while left < right:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 569.4 Tm (        s = nums[left] + nums[right]) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 559.4 Tm (        if s == target:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 549.4 Tm (            return [left, right]) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 539.4 Tm (        if s < target:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 529.4 Tm (            left += 1          # need a bigger sum) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 519.4 Tm (        else:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 509.4 Tm (            right -= 1         # need a smaller sum) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 499.3 Tm (    return []) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 482.0 Tm (# --- unsorted input: hash map, O\(n\) time, O\(n\) space ---) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 472.0 Tm (def two_sum_hash\(nums, target\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 462.0 Tm (    seen = {}                          # value -> index) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 452.0 Tm (    for i, x in enumerate\(nums\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 441.9 Tm (        want = target - x) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 431.9 Tm (        if want in seen:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 421.9 Tm (            return [seen[want], i]) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 411.9 Tm (        seen[x] = i) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 401.9 Tm (    return []) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 384.5 Tm (# --- generalisation: three sum, O\(n^2\) after sorting ---) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 374.5 Tm (def three_sum\(nums\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 364.5 Tm (    nums.sort\(\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 354.5 Tm (    out = []) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 344.5 Tm (    for i in range\(len\(nums\) - 2\):) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 334.5 Tm (        if i and nums[i] == nums[i-1]:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 324.5 Tm (            continue                    # skip duplicate anchors) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 314.5 Tm (        lo, hi = i + 1, len\(nums\) - 1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 304.5 Tm (        while lo < hi:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 294.5 Tm (            s = nums[i] + nums[lo] + nums[hi]) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 284.5 Tm (            if s < 0:  lo += 1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 274.5 Tm (            elif s > 0: hi -= 1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 264.5 Tm (            else:) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 254.5 Tm (                out.append\([nums[i], nums[lo], nums[hi]]\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 244.5 Tm (                while lo < hi and nums[lo] == nums[lo+1]: lo += 1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 234.5 Tm (                while lo < hi and nums[hi] == nums[hi-1]: hi -= 1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 224.5 Tm (                lo += 1; hi -= 1) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 214.5 Tm (    return out) Tj ET
