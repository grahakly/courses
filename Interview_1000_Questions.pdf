BT /F3 8.2 Tf 1 0 0 1 62 673.2 Tm (    audit_id   BIGSERIAL PRIMARY KEY,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 663.2 Tm (    order_id   INT NOT NULL,) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 653.2 Tm (    old_status VARCHAR\(20\),) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 643.2 Tm (    new_status VARCHAR\(20\),) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 633.2 Tm (    changed_at TIMESTAMPTZ NOT NULL DEFAULT NOW\(\),) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 623.2 Tm (    changed_by TEXT NOT NULL DEFAULT CURRENT_USER) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 613.2 Tm (\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 595.8 Tm (CREATE OR REPLACE FUNCTION audit_order_status\(\) RETURNS TRIGGER) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 585.8 Tm (LANGUAGE plpgsql AS $$) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 575.8 Tm (BEGIN) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 565.8 Tm (    -- only log real changes; IS DISTINCT FROM is NULL-safe) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 555.8 Tm (    IF NEW.status IS DISTINCT FROM OLD.status THEN) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 545.8 Tm (        INSERT INTO order_status_audit \(order_id, old_status, new_status\)) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 535.8 Tm (        VALUES \(OLD.order_id, OLD.status, NEW.status\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 525.8 Tm (    END IF;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 515.8 Tm (    RETURN NEW;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 505.8 Tm (END; $$;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 488.4 Tm (CREATE TRIGGER trg_audit_order_status) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 478.4 Tm (AFTER UPDATE OF status ON orders          -- column-specific: fires less often) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 468.4 Tm (FOR EACH ROW EXECUTE FUNCTION audit_order_status\(\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 451.0 Tm (UPDATE orders SET status = 'SHIPPED' WHERE order_id = 5;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 441.0 Tm (SELECT order_id, old_status, new_status FROM order_status_audit;) Tj ET
