BT /F3 8.2 Tf 1 0 0 1 62 728.0 Tm (// ---------- logout: revoke the whole family ----------) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 718.0 Tm (app.post\("/auth/logout", authenticate, wrap\(async \(req, res\) => {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 708.0 Tm (  await db.collection\("refresh_tokens"\).deleteMany\({ userId: new ObjectId\(req.user.sub\) }\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 698.0 Tm (  res.clearCookie\("rt", { path: "/auth/refresh" }\).status\(204\).end\(\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 688.0 Tm (}\)\);) Tj ET
