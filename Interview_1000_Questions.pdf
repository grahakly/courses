BT /F3 8.2 Tf 1 0 0 1 62 656.8 Tm (    printf\("child  pid=%d counter=%d\\n", getpid\(\), counter++\);   // separate copy) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 646.8 Tm (    _exit\(0\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 636.8 Tm (} else {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 626.8 Tm (    wait\(NULL\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 616.8 Tm (    printf\("parent pid=%d counter=%d\\n", getpid\(\), counter\);     // unchanged by the child) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 606.8 Tm (}) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 580.8 Tm (// threads: shared memory means a data race without synchronisation) Tj ET
