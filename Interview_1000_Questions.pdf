BT /F3 8.2 Tf 1 0 0 1 62 523.2 Tm (app.use\(express.json\({ limit: "100kb" }\)\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 505.8 Tm (// 4. route-level middleware: auth applies only to this route) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 495.8 Tm (const requireAuth = \(req, res, next\) => {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 485.8 Tm (  const token = req.get\("authorization"\)?.replace\(/^Bearer /, ""\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 475.8 Tm (  if \(!token\) return next\(Object.assign\(new Error\("Unauthorized"\), { status: 401 }\)\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 465.8 Tm (  req.user = { id: "u_1", role: "customer" };   // verified elsewhere) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 455.8 Tm (  next\(\);) Tj ET
