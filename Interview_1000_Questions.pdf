BT /F3 8.2 Tf 1 0 0 1 62 663.2 Tm (  const sql = `SELECT customer_id, full_name) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 653.2 Tm (               FROM   customers) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 643.2 Tm (               WHERE  email = $1 AND password_hash = $2`;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 633.2 Tm (  // $1/$2 are bound as VALUES; the string "' OR '1'='1" is just a string) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 623.2 Tm (  return \(await pool.query\(sql, [email, passwordHash]\)\).rows;) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 613.2 Tm (}) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 595.8 Tm (// ================= SAFE: dynamic sort column via allow-list =================) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 585.8 Tm (const SORTABLE = {           // identifiers cannot be parameters -> map them) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 575.8 Tm (  name:  'full_name',) Tj ET
