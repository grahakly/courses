BT /F3 8.2 Tf 1 0 0 1 62 428.4 Tm (// async wrapper: Express 4 does not catch rejected promises) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 418.4 Tm (const wrap = fn => \(req, res, next\) => Promise.resolve\(fn\(req, res, next\)\).catch\(next\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 401.0 Tm (app.get\("/orders/:id", requireAuth, wrap\(async \(req, res\) => {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 391.0 Tm (  const order = await findOrder\(req.params.id\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 381.0 Tm (  if \(!order\) {) Tj ET
