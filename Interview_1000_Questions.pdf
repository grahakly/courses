BT /F3 8.2 Tf 1 0 0 1 62 663.2 Tm (  const sql = `SELECT customer_id, full_name) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 653.2 Tm (               FROM   customers) Tj ET
