BT /F3 8.2 Tf 1 0 0 1 62 533.4 Tm (void *worker\(void *_\) {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 523.4 Tm (    for \(int i = 0; i < 100000; i++\) {) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 513.4 Tm (        pthread_mutex_lock\(&lock\);      // remove this to see the race) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 503.4 Tm (        shared++;                       // read-modify-write is NOT atomic) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 493.4 Tm (        pthread_mutex_unlock\(&lock\);) Tj ET
BT /F3 8.2 Tf 1 0 0 1 62 483.3 Tm (    }) Tj ET
